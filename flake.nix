{
  description = "NixOS homelab configuration";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    home-manager = {
      url = "github:nix-community/home-manager";
      # Pin home-manager's nixpkgs to ours so it evaluates against one shared
      # nixpkgs instead of pulling in its own copy.
      inputs.nixpkgs.follows = "nixpkgs";
    };
    sops-nix.url = "github:Mic92/sops-nix";
    # Same reasoning as above: avoid a second, independent nixpkgs evaluation.
    sops-nix.inputs.nixpkgs.follows = "nixpkgs";
    chatgpt-desktop = {
      # The Debian installer is stored in Git LFS and must be fetched with it.
      url = "git+https://github.com/joe-broder15/chatgpt-desktop-nix-flake.git?lfs=1";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    # Grok Bot desktop agent (proprietary .deb, amd64 only).
    grok-bot = {
      url = "github:jordangarrison/grok-bot-flake";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    # OpenClaw (homelab), via the official Nix packaging. Its overlay builds
    # against our nixpkgs; the input keeps its own pins for its tool flakes.
    nix-openclaw.url = "github:openclaw/nix-openclaw";
    # Last nixpkgs commit that still packaged brave (1.96.61, 2026-10-04).
    # Not followed to nixpkgs: unstable removed it on 2026-11-03. This pin
    # does not move on a normal flake update.
    nixpkgs-brave.url = "github:NixOS/nixpkgs/a322c65bf7233456788a9ebf03bc067db7dc090a";
  };

  outputs =
    inputs@{
      nixpkgs,
      home-manager,
      sops-nix,
      chatgpt-desktop,
      grok-bot,
      nix-openclaw,
      ...
    }:
    let
      system = "x86_64-linux";
      # Only this package is taken from the pinned nixpkgs. The rest of the
      # system stays on unstable.
      brave = (import inputs.nixpkgs-brave {
        inherit system;
        config.allowUnfree = true;
      }).brave;
      homeExtraSpecialArgs = {
        inherit brave;
        chatgptDesktop = chatgpt-desktop.packages.${system}.default;
        grokBot = grok-bot.packages.${system}.default;
      };
      # Built explicitly because homeConfigurations.zircon (below) needs a pkgs
      # argument directly; nixosSystem builds its own internally from `system`.
      pkgs = import nixpkgs {
        inherit system;
        config.allowUnfree = true;
      };
    in
    {
      nixosConfigurations.homelab = nixpkgs.lib.nixosSystem {
        inherit system;
        modules = [
          # Read from the host's own filesystem, not tracked in git: it's
          # machine-specific (disks/UUIDs) and generated by nixos-generate-config
          # on each host, so it can't be a portable, shared repo file.
          /etc/nixos/hardware-configuration.nix
          ./configurations/homelab/configuration.nix
          sops-nix.nixosModules.sops
          # OpenClaw as a system service (nix-openclaw's overlay + NixOS
          # module); configured in configurations/homelab/openclaw.nix.
          nix-openclaw.nixosModules.openclaw-gateway
          { nixpkgs.overlays = [ nix-openclaw.overlays.default ]; }
        ];
      };

      nixosConfigurations.thinkpad = nixpkgs.lib.nixosSystem {
        inherit system;
        modules = [
          /etc/nixos/hardware-configuration.nix
          ./configurations/thinkpad/configuration.nix
          # zircon's profile is only NixOS-integrated on the desktop-class hosts:
          # homelab is a headless server with no zircon session to manage.
          home-manager.nixosModules.home-manager
          {
            home-manager.useGlobalPkgs = true;
            home-manager.useUserPackages = true;
            home-manager.extraSpecialArgs = homeExtraSpecialArgs;
            home-manager.users.zircon = ./home/zircon.nix;
          }
          sops-nix.nixosModules.sops
        ];
      };

      nixosConfigurations.desktop = nixpkgs.lib.nixosSystem {
        inherit system;
        modules = [
          /etc/nixos/hardware-configuration.nix
          ./configurations/desktop/configuration.nix
          # Same desktop-class home-manager wiring as thinkpad, for this second machine.
          home-manager.nixosModules.home-manager
          {
            home-manager.useGlobalPkgs = true;
            home-manager.useUserPackages = true;
            home-manager.extraSpecialArgs = homeExtraSpecialArgs;
            home-manager.users.zircon = ./home/zircon.nix;
          }
          sops-nix.nixosModules.sops
        ];
      };

      # Standalone Home Manager configuration. Usable on any machine with Nix
      # (not just NixOS) via:
      #   nix run home-manager/master -- switch --flake .#zircon
      #   home-manager switch --flake .#zircon
      homeConfigurations.zircon = home-manager.lib.homeManagerConfiguration {
        inherit pkgs;
        extraSpecialArgs = homeExtraSpecialArgs;
        modules = [ ./home/zircon.nix ];
      };

      formatter.${system} = pkgs.nixfmt-tree;
    };
}
