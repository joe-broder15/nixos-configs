{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "nix fmt . >/dev/null 2>&1 || true"
          },
          {
            "type": "command",
            "command": "nix flake check --no-build --impure >/dev/null 2>&1 || true",
            "async": true
          }
        ]
      }
    ]
  }
}
